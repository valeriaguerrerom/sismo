# Configuración de las pruebas E2E (Playwright). Copia este archivo a .env.e2e
# y rellena los valores. .env.e2e NO se sube al repositorio (está en .gitignore).

# --- Cuenta de prueba (prueba1): un INVESTIGADOR normal, perfil ya completo ---
# Debe existir en Supabase Auth + profiles (active=true, con institución y
# ocupación para saltar el paso "Completar perfil"). NO debe ser admin.
E2E_USER_EMAIL=prueba1@ejemplo.com
E2E_USER_PASSWORD=cambia-esto

# --- URLs por entorno (opcional; tienen valores por defecto sensatos) ---
# Local = contenedor docker con nginx + CSP en modo bloqueo.
E2E_LOCAL_URL=http://localhost:8080
# Producción.
E2E_PROD_URL=https://sismonarino.com

# --- Opcional: credenciales de Supabase para la limpieza de datos en prod ---
# Si se definen, el teardown borra por API los reportes/comentarios creados por
# la cuenta de prueba. Si no, las pruebas limpian desde la propia UI.
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
