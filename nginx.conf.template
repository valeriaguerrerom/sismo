# Plantilla de Nginx para la SPA de SismoNariño (Railway / producción).
#
# El contenedor genera /etc/nginx/conf.d/default.conf a partir de esta plantilla
# con `envsubst` al arrancar (ver Dockerfile), sustituyendo:
#   ${BACKEND_ORIGIN}    URL del backend para connect-src de la CSP
#                        (p. ej. https://api.midominio.com). Vacío = solo 'self'
#                        y Supabase.
#   ${CSP_HEADER_NAME}   "Content-Security-Policy-Report-Only" (primer despliegue,
#                        no rompe nada, solo reporta en consola) o
#                        "Content-Security-Policy" (modo bloqueo definitivo).
#
# Nginx escucha en 8080 (Railway apunta el dominio a ese puerto). NO hay proxy
# /api: el backend es otro servicio y el frontend lo llama por VITE_API_URL.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    client_max_body_size 25m;

    # ── Cabeceras de seguridad ──
    # CSP compatible con: Supabase (REST/Auth/Storage/Realtime), Google OAuth,
    # Google Fonts, teselas de OpenStreetMap (Leaflet) y el Mapa 3D (Three.js,
    # que carga sus texturas/datos desde /terrain y /textures locales → 'self').
    #
    #  - style-src usa 'unsafe-inline' (Tailwind/React/Leaflet aplican estilos en
    #    línea); NO se permite 'unsafe-inline' en script-src.
    #  - img-src permite data: y blob: (capturas html2canvas, canvas de Three.js)
    #    y las teselas del mapa.
    #  - connect-src incluye el backend (${BACKEND_ORIGIN}) y Supabase, con wss://
    #    para Realtime (websockets) por si se usa.
    set $csp "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org; connect-src 'self' https://*.supabase.co wss://*.supabase.co ${BACKEND_ORIGIN}; frame-src https://accounts.google.com https://*.supabase.co; worker-src 'self' blob:; upgrade-insecure-requests";
    add_header ${CSP_HEADER_NAME} $csp always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header X-Frame-Options "DENY" always;

    # Estáticos con caché larga (Vite les pone hash en el nombre).
    # Se repiten las cabeceras de seguridad porque un `add_header` en el location
    # anula los del server (nginx no los hereda si el bloque define alguno).
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header ${CSP_HEADER_NAME} $csp always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header X-Frame-Options "DENY" always;
    }

    # SPA: cualquier ruta desconocida devuelve index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
