{
  "entryPointStrategy": "expand",
  "entryPoints": ["src"],
  "out": "public/docs/frontend",
  "name": "SismoNariño — Frontend",
  "readme": "none",
  "excludePrivate": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "disableSources": true,
  "exclude": [
    "**/node_modules/**",
    "**/*.css",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "src/vite-env.d.ts"
  ],
  "tsconfig": "tsconfig.app.json"
}
