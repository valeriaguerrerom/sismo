{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "powershell -ExecutionPolicy Bypass -File scripts/install-pw-browsers.ps1",
    "e2e:local": "cross-env E2E_ENV=local playwright test",
    "e2e:local:up": "docker compose -f docker-compose.e2e.yml up --build -d --wait",
    "e2e:local:down": "docker compose -f docker-compose.e2e.yml down -v",
    "e2e:local:full": "pnpm e2e:local:up && cross-env E2E_ENV=local playwright test; pnpm e2e:local:down",
    "e2e:prod": "cross-env E2E_ENV=prod playwright test",
    "e2e:report": "playwright show-report playwright-report/prod",
    "docs:frontend": "typedoc --entryPointStrategy expand src --out docs/frontend --name \"SismoNariño Frontend\" --readme none",
    "docs:backend": "cd backend && py -m pdoc main simulation --output-dir ../docs/backend --html --force",
    "docs": "pnpm docs:frontend"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "driver.js": "^1.8.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "three": "^0.183.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.18",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.8",
    "typedoc": "^0.28.19",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
